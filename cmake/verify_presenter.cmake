# Run at the end of every build (the verify_presenter target): fails the build when the presenter that would be installed
# is not the one the sources make. On 2026-11-18 a build left the presenter of the night before in place - its shaders
# built in (shaders.pack) older still - and that is what went into the games: the fix tested in game never ran there.
# Checked: the shader pack is no older than the shader source; the exe and the dll are no older than any presenter source
# or the pack; each of them carries this pack, whole.
# Arguments (-D): PACK, EXE, DLL, SRC (the presenter's source folder).
foreach(v PACK EXE DLL SRC)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "verify_presenter: ${v} not given")
  endif()
endforeach()
set(problems "")
foreach(f "${PACK}" "${EXE}" "${DLL}")
  if(NOT EXISTS "${f}")
    string(APPEND problems "\n  missing: ${f}")
  endif()
endforeach()
if(problems STREQUAL "")
  # (IS_NEWER_THAN is also true for the same time stamp - a file written in the same second counts as fresh)
  if(NOT "${PACK}" IS_NEWER_THAN "${SRC}/renderer.cpp")
    string(APPEND problems "\n  the shader pack is older than renderer.cpp: the shaders were not baked again")
  endif()
  file(GLOB sources "${SRC}/*.cpp" "${SRC}/*.hpp")
  foreach(bin "${EXE}" "${DLL}")
    get_filename_component(name "${bin}" NAME)
    foreach(s ${sources} "${PACK}")
      if(NOT "${bin}" IS_NEWER_THAN "${s}")
        get_filename_component(sname "${s}" NAME)
        string(APPEND problems "\n  ${name} is older than ${sname}: it was not built again")
      endif()
    endforeach()
    # (the whole pack: a part of it - its last bytes - can be a shader that did not change)
    if(NOT DEFINED pack_hex)
      file(READ "${PACK}" pack_hex HEX)
    endif()
    file(READ "${bin}" content HEX)
    string(FIND "${content}" "${pack_hex}" at)
    if(at EQUAL -1)
      string(APPEND problems "\n  ${name} does not carry the current shader pack")
    endif()
  endforeach()
endif()
if(NOT problems STREQUAL "")
  message(FATAL_ERROR "verify_presenter: the built presenter is stale - do not install it:${problems}")
endif()
message(STATUS "verify_presenter: exe and dll are fresh and carry the current shader pack")
